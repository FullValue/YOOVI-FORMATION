# ─── Supabase (production) ───────────────────────────────────────────────
# Projet Supabase dédié à formation.yoovi.fr. Sans ces deux variables,
# l'application démarre en MODE DÉMO (données locales dans .data/, aucun e-mail envoyé).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role : SERVEUR UNIQUEMENT (invitations, désactivation de comptes,
# réinitialisation des accès). Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de la plateforme (liens d'invitation et de réinitialisation)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Adresse du support affichée et utilisée par le bouton « Contacter le support »
NEXT_PUBLIC_SUPPORT_EMAIL=support@yoovi.fr

# ─── Mode démo ────────────────────────────────────────────────────────────
# En production, le mode démo est refusé sauf si YOOVI_DEMO_MODE=1.
YOOVI_DEMO_MODE=
